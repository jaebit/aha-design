{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "STORYBOOK_DISABLE_TELEMETRY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@actoz/ui#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/kit-*/src/**"
      ]
    },
    "storybook": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "@actoz/ui#build-storybook": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/kit-*/src/**",
        "$TURBO_ROOT$/packages/kit-*/package.json"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "@actoz/gallery#build": {
      "dependsOn": [
        "^build",
        "@actoz/ui#build-storybook"
      ],
      "outputs": [
        "dist/**",
        "generated/**"
      ]
    },
    "@actoz/gallery#typecheck": {
      "dependsOn": [
        "^build",
        "@actoz/ui#build-storybook"
      ],
      "outputs": [
        "generated/**"
      ]
    }
  }
}
