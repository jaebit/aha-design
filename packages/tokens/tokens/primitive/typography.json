{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Pretendard Variable",
          "Pretendard",
          "-apple-system",
          "BlinkMacSystemFont",
          "Apple SD Gothic Neo",
          "Malgun Gothic",
          "sans-serif"
        ],
        "$description": "기본 서체 Pretendard. @aha/ui/styles.css가 pretendard npm 패키지의 웹폰트를 불러온다 (외부 CDN 없음)"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "D2Coding",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "DejaVu Sans Mono",
          "Pretendard Variable",
          "monospace"
        ],
        "$description": "코드 서체. 영문은 시스템 고정폭 서체로, 고정폭 서체에 없는 한글은 Pretendard로 그린다"
      }
    },
    "size": {
      "$type": "dimension",
      "caption": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "태그, 배지, 날짜 같은 메타 정보"
      },
      "body-sm": {
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$description": "보조 본문, 안내 문구, 사이드바 기록 항목"
      },
      "body": {
        "$value": {
          "value": 15,
          "unit": "px"
        },
        "$description": "기본 본문과 대화 메시지"
      },
      "heading": {
        "$value": {
          "value": 17,
          "unit": "px"
        },
        "$description": "카드 제목, 대화 헤더 제목"
      },
      "title": {
        "$value": {
          "value": 22,
          "unit": "px"
        },
        "$description": "페이지 제목, 서비스 사이드바 제목"
      },
      "display": {
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$description": "홈 인사말, 빈 상태 히어로 제목"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.3,
        "$description": "제목"
      },
      "normal": {
        "$value": 1.6,
        "$description": "본문. 한글 가독성을 위해 1.6 이상"
      }
    }
  }
}
