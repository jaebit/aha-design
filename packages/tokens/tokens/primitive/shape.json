{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" }, "$description": "작은 입력, 체크박스" },
    "md": { "$value": { "value": 10, "unit": "px" }, "$description": "버튼, 메뉴 항목, 사이드바 항목" },
    "lg": { "$value": { "value": 16, "unit": "px" }, "$description": "카드, 콜아웃, 결과 카드" },
    "xl": { "$value": { "value": 24, "unit": "px" }, "$description": "입력창(Composer), 말풍선" },
    "full": { "$value": { "value": 9999, "unit": "px" }, "$description": "칩, 배지, 원형 아이콘 버튼" }
  },
  "shadow": {
    "$type": "shadow",
    "popover": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.08, "hex": "#000000" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "메뉴, 팝오버, 툴팁에만 쓴다. 카드는 그림자 대신 테두리로 구분한다."
    }
  }
}
