// design-hub 검사 작업 (Jenkins job: design-hub-ci).
// main 푸시 웹훅으로 실행된다. 배포 credential은 받지 않는다 (forgejo-platform D-012, D-013).
// 플랫폼 규칙상 Jenkins job에는 이 파일 내용을 인라인으로 넣는다 (Pipeline from SCM을 쓰지 않는다). 바꾸면 setup으로 job을 다시 만든다.
pipeline {
    agent { label 'local-linux' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }
    environment {
        FORGEJO_API_URL = 'http://forgejo:3000/api/v1'
        FORGEJO_REPOSITORY = 'jay/design-hub'
        STORYBOOK_DISABLE_TELEMETRY = '1'
        // 에이전트 메모리(3GB)에 맞춰 turbo 작업을 하나씩 돌린다.
        TURBO_CONCURRENCY = '1'
    }
    stages {
        stage('Checkout main') {
            steps {
                deleteDir()
                git branch: 'main', credentialsId: 'design-hub-read', url: 'http://forgejo:3000/jay/design-hub.git'
                script { env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim() }
            }
        }
        stage('Pending status') {
            steps { script { reportStatus('pending', '검사 중') } }
        }
        stage('Install') {
            steps { sh 'pnpm install --frozen-lockfile' }
        }
        stage('Typecheck') {
            steps { sh 'pnpm typecheck --concurrency=1' }
        }
        stage('Build') {
            steps { sh 'pnpm build --concurrency=1' }
        }
        stage('Token rules') {
            steps {
                sh 'pnpm check:tokens'
                sh 'pnpm check:contrast'
            }
        }
        stage('MCP docs') {
            steps {
                sh '''
                    (cd packages/ui && pnpm storybook --ci > "$WORKSPACE/storybook.log" 2>&1 &)
                    node -e 'const go=async(n)=>{try{const r=await fetch("http://localhost:6006/index.json");if(r.ok)return}catch{}if(n<=0){console.error("Storybook이 뜨지 않았습니다");process.exit(1)}await new Promise(r=>setTimeout(r,2000));return go(n-1)};go(90)'
                    pnpm check:mcp-docs
                '''
            }
            post {
                always {
                    sh 'pkill -f "storybook dev" || true'
                }
            }
        }
    }
    post {
        success { script { reportStatus('success', '검사 통과') } }
        failure { script { if (env.GIT_COMMIT) { reportStatus('failure', '검사 실패') } } }
    }
}

// Forgejo 커밋 상태. 토큰은 이 단계에서만 꺼내고 출력하지 않는다.
def reportStatus(String state, String description) {
    withCredentials([string(credentialsId: 'design-hub-status', variable: 'FORGEJO_STATUS_TOKEN')]) {
        withEnv(["STATUS_STATE=${state}", "STATUS_DESCRIPTION=${description}"]) {
            sh '''set +x
                node -e '
                  const body = JSON.stringify({ state: process.env.STATUS_STATE, context: "jenkins/design-hub-ci",
                    description: process.env.STATUS_DESCRIPTION, target_url: process.env.BUILD_URL });
                  fetch(`${process.env.FORGEJO_API_URL}/repos/${process.env.FORGEJO_REPOSITORY}/statuses/${process.env.GIT_COMMIT}`, {
                    method: "POST", body,
                    headers: { "Content-Type": "application/json", Authorization: `token ${process.env.FORGEJO_STATUS_TOKEN}` },
                  }).then((r) => { if (!r.ok) { console.error(`커밋 상태 보고 실패 HTTP ${r.status}`); process.exit(1); } });
                '
            '''
        }
    }
}
