// aha-design 배포 작업 (Jenkins job: aha-design-release). 사람이 RELEASE_TAG를 넣어 수동으로 실행한다.
// main에 포함된 tag만 배포하고, 배포 credential은 Publish 단계에서만 꺼낸다 (forgejo-platform D-013).
// 버전은 PR에서 pnpm version-packages로 이미 올라가 있어야 한다. 여기서는 레지스트리에 없는 버전만 올린다.
pipeline {
    agent { label 'local-linux' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        string(name: 'RELEASE_TAG', defaultValue: '', description: 'main에 있는 커밋을 가리키는 release-YYYYMMDD-N 형식의 tag')
    }
    environment {
        FORGEJO_API_URL = 'http://forgejo:3000/api/v1'
        FORGEJO_REPOSITORY = 'jay/aha-design'
        STORYBOOK_DISABLE_TELEMETRY = '1'
        TURBO_CONCURRENCY = '1'
    }
    stages {
        stage('Validate tag') {
            steps {
                script {
                    // 붙여넣을 때 섞인 앞뒤 공백은 지운다. 빌드 매개변수 이름(RELEASE_TAG)의 환경 변수는 덮어쓸 수 없어 TAG에 둔다.
                    env.TAG = (params.RELEASE_TAG ?: '').trim()
                    if (!(env.TAG ==~ /release-[0-9]{8}-[0-9]{1,3}/)) {
                        error("INVALID_RELEASE_TAG: release-YYYYMMDD-N 형식의 tag가 필요합니다 (받은 값: \"${params.RELEASE_TAG}\").")
                    }
                }
            }
        }
        stage('Checkout tag') {
            steps {
                deleteDir()
                checkout([$class: 'GitSCM', branches: [[name: "refs/tags/${env.TAG}"]],
                    userRemoteConfigs: [[url: 'http://forgejo:3000/jay/aha-design.git', credentialsId: 'aha-design-read',
                        refspec: '+refs/heads/main:refs/remotes/origin/main +refs/tags/*:refs/tags/*']]])
                script { env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim() }
                sh 'git merge-base --is-ancestor "$GIT_COMMIT" origin/main'
            }
        }
        stage('CI passed') {
            steps {
                // aha-design-ci가 이 커밋을 검사해 통과했는지 Forgejo 커밋 상태로 확인한다. 검사 없이 배포하지 않는다.
                withCredentials([string(credentialsId: 'aha-design-status', variable: 'FORGEJO_STATUS_TOKEN')]) {
                    sh '''set +x
                        node -e '
                          fetch(`${process.env.FORGEJO_API_URL}/repos/${process.env.FORGEJO_REPOSITORY}/commits/${process.env.GIT_COMMIT}/status`, {
                            headers: { Authorization: `token ${process.env.FORGEJO_STATUS_TOKEN}` },
                          }).then(async (r) => {
                            if (!r.ok) { console.error(`커밋 상태 조회 실패 HTTP ${r.status}`); process.exit(1); }
                            const { state } = await r.json();
                            if (state !== "success") {
                              console.error(`CI_NOT_PASSED: 이 커밋의 검사 상태가 "${state}"입니다. aha-design-ci가 통과한 main 커밋에 tag를 다세요.`);
                              process.exit(1);
                            }
                            console.log("CI 통과 확인");
                          });
                        '
                    '''
                }
            }
        }
        stage('Build without publish credentials') {
            steps {
                sh 'pnpm install --frozen-lockfile'
                // compat/*: 예전 범위(@aha)의 호환 패키지. @actoz 패키지를 다시 내보낸다 (AHA·IAM 통합 5단계).
                sh 'pnpm turbo run build --filter="./packages/*" --filter="./compat/*" --concurrency=1'
            }
        }
        stage('Publish') {
            steps {
                // 레지스트리 주소는 Forgejo ROOT_URL(localhost:3000)이라, 이 단계 동안만 socat으로 forgejo:3000에 잇는다.
                withCredentials([string(credentialsId: 'aha-design-package-publish', variable: 'PACKAGE_TOKEN')]) {
                    sh '''set +x
                        socat TCP-LISTEN:3000,bind=127.0.0.1,fork,reuseaddr TCP:forgejo:3000 &
                        SOCAT_PID=$!
                        sleep 1; kill -0 $SOCAT_PID 2>/dev/null || { echo 'socat을 띄우지 못했습니다 (127.0.0.1:3000 사용 중?)' >&2; exit 1; }
                        trap 'kill $SOCAT_PID 2>/dev/null; rm -f "$NPMRC"' EXIT
                        NPMRC=$(mktemp) && chmod 600 "$NPMRC"
                        # 새 범위(actoz 조직)와 호환 패키지의 예전 범위(aha 조직). 같은 토큰을 쓴다 (ci-design-hub가 두 조직 팀에 있다).
                        printf '%s\\n' "@actoz:registry=http://localhost:3000/api/packages/actoz/npm/" \
                          "@aha:registry=http://localhost:3000/api/packages/aha/npm/" \
                          "//localhost:3000/api/packages/actoz/npm/:_authToken=${PACKAGE_TOKEN}" \
                          "//localhost:3000/api/packages/aha/npm/:_authToken=${PACKAGE_TOKEN}" > "$NPMRC"
                        export NPM_CONFIG_USERCONFIG="$NPMRC"
                        unset PACKAGE_TOKEN
                        pnpm changeset publish-plan
                        pnpm changeset publish --no-git-tag
                    '''
                }
            }
        }
        stage('Verify') {
            steps {
                // 공개 조직이라 인증 없이 조회한다. 배포된 버전이 레지스트리에 보이는지 확인한다.
                sh '''
                    socat TCP-LISTEN:3000,bind=127.0.0.1,fork,reuseaddr TCP:forgejo:3000 &
                    SOCAT_PID=$!
                    sleep 1; kill -0 $SOCAT_PID 2>/dev/null || { echo 'socat을 띄우지 못했습니다 (127.0.0.1:3000 사용 중?)' >&2; exit 1; }
                    trap 'kill $SOCAT_PID 2>/dev/null' EXIT
                    for dir in packages/*/ compat/*/; do
                      name=$(node -p "require('./${dir}package.json').name")
                      version=$(node -p "require('./${dir}package.json').version")
                      registry=$(node -p "require('./${dir}package.json').publishConfig.registry")
                      npm view "${name}@${version}" version --registry "$registry"
                    done
                '''
            }
        }
    }
}
