// design-hub 배포 작업 (Jenkins job: design-hub-release). 사람이 RELEASE_TAG를 넣어 수동으로 실행한다.
// main에 포함된 tag만 배포하고, 배포 credential은 Publish 단계에서만 꺼낸다 (forgejo-platform D-013).
// 버전은 PR에서 pnpm version-packages로 이미 올라가 있어야 한다. 여기서는 레지스트리에 없는 버전만 올린다.
pipeline {
    agent { label 'local-linux' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        string(name: 'RELEASE_TAG', defaultValue: '', description: 'main에 있는 커밋을 가리키는 release-YYYYMMDD-N 형식의 tag')
    }
    environment {
        STORYBOOK_DISABLE_TELEMETRY = '1'
        TURBO_CONCURRENCY = '1'
    }
    stages {
        stage('Validate tag') {
            steps {
                script {
                    if (!(params.RELEASE_TAG ==~ /release-[0-9]{8}-[0-9]{1,3}/)) {
                        error('INVALID_RELEASE_TAG: release-YYYYMMDD-N 형식의 tag가 필요합니다.')
                    }
                }
            }
        }
        stage('Checkout tag') {
            steps {
                deleteDir()
                checkout([$class: 'GitSCM', branches: [[name: "refs/tags/${params.RELEASE_TAG}"]],
                    userRemoteConfigs: [[url: 'http://forgejo:3000/jay/design-hub.git', credentialsId: 'design-hub-read',
                        refspec: '+refs/heads/main:refs/remotes/origin/main +refs/tags/*:refs/tags/*']]])
                script { env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim() }
                sh 'git merge-base --is-ancestor "$GIT_COMMIT" origin/main'
            }
        }
        stage('Build without publish credentials') {
            steps {
                sh 'pnpm install --frozen-lockfile'
                sh 'pnpm turbo run build --filter="./packages/*" --concurrency=1'
            }
        }
        stage('Publish') {
            steps {
                // 레지스트리 주소는 Forgejo ROOT_URL(localhost:3000)이라, 이 단계 동안만 socat으로 forgejo:3000에 잇는다.
                withCredentials([string(credentialsId: 'design-hub-package-publish', variable: 'PACKAGE_TOKEN')]) {
                    sh '''set +x
                        socat TCP-LISTEN:3000,bind=127.0.0.1,fork,reuseaddr TCP:forgejo:3000 &
                        SOCAT_PID=$!
                        trap 'kill $SOCAT_PID 2>/dev/null; rm -f "$NPMRC"' EXIT
                        NPMRC=$(mktemp) && chmod 600 "$NPMRC"
                        printf '%s\\n' "@aha:registry=http://localhost:3000/api/packages/aha/npm/" \
                          "//localhost:3000/api/packages/aha/npm/:_authToken=${PACKAGE_TOKEN}" > "$NPMRC"
                        export NPM_CONFIG_USERCONFIG="$NPMRC"
                        unset PACKAGE_TOKEN
                        pnpm changeset publish-plan
                        pnpm changeset publish --no-git-tag
                    '''
                }
            }
        }
        stage('Verify') {
            steps {
                // 공개 조직이라 인증 없이 조회한다. 배포된 버전이 레지스트리에 보이는지 확인한다.
                sh '''
                    socat TCP-LISTEN:3000,bind=127.0.0.1,fork,reuseaddr TCP:forgejo:3000 &
                    SOCAT_PID=$!
                    trap 'kill $SOCAT_PID 2>/dev/null' EXIT
                    for dir in packages/*/; do
                      name=$(node -p "require('./${dir}package.json').name")
                      version=$(node -p "require('./${dir}package.json').version")
                      npm view "${name}@${version}" version --registry http://localhost:3000/api/packages/aha/npm/
                    done
                '''
            }
        }
    }
}
