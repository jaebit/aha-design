{
  "name": "@aha/ui",
  "version": "0.3.4",
  "description": "[폐기 예정] 새 패키지: @actoz/ui. 이 패키지는 새 패키지를 다시 내보내기만 한다. import와 CSS의 패키지 이름을 바꾼다.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "styles.css",
    "README.md"
  ],
  "publishConfig": {
    "registry": "http://localhost:3000/api/packages/aha/npm/"
  },
  "dependencies": {
    "@actoz/ui": "workspace:^",
    "@aha/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
