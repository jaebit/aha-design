{
  "name": "aha-design",
  "private": true,
  "description": "AHA 사내 디자인 시스템 모노레포 (토큰, UI 컴포넌트, Storybook 갤러리 + MCP)",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run storybook",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "typecheck": "turbo run typecheck",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:mcp-docs": "node scripts/check-mcp-docs.mjs",
    "check:contrast": "pnpm --filter @actoz/tokens build && pnpm --filter @actoz/tokens check:contrast",
    "test:codemods": "node --test scripts/codemods/iam-to-actoz.test.mjs",
    "gallery": "pnpm build-storybook && pnpm --filter @actoz/gallery dev",
    "gallery:iam": "pnpm build-storybook && SITE=iam pnpm --filter @actoz/gallery dev",
    "docker:up": "docker compose up -d --build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* --filter=./compat/* && changeset publish --no-git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.0",
    "typescript": "~6.0.3"
  }
}
