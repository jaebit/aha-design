{
  "name": "@aha/gallery",
  "version": "0.1.0",
  "private": true,
  "description": "AHA 디자인 시스템 갤러리 사이트 + MCP 서버",
  "type": "module",
  "scripts": {
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "node scripts/build-catalog.mjs && vite",
